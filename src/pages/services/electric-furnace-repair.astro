---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Electric Furnace Repair Laurel MD | Element & Sequencer Service" description="Electric furnace repair in Laurel, MD. Heating elements, sequencers, and control boards. Same-day service available.">
  <section class="page-hero">
    <div class="container">
      <h1>Electric Furnace Repair in Laurel, MD</h1>
      <p>Electric furnaces and air handlers need specialized diagnosis. We test elements, sequencers, and controls accurately.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get a Quote — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <h2>Electric Heating Specialists</h2>
      <p>Electric furnaces use heating elements and sequencers instead of gas combustion. Common failures include open elements, failed sequencers, and control board issues.</p>
      <h3>Services Include</h3>
      <ul>
        <li>Heating element testing and replacement</li>
        <li>Sequencer and relay service</li>
        <li>Limit switch and safety control checks</li>
        <li>Blower and capacitor diagnostics</li>
        <li>Thermostat and low-voltage troubleshooting</li>
      </ul>
      <p><a href={`tel:${phone}`} class="btn btn-primary">Schedule Electric Furnace Repair</a></p>
    </div>
  </section>
</Layout>
