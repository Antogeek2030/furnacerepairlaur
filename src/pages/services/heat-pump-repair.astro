---
import Layout from '../../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Heat Pump Repair Laurel MD | Dual-Fuel & Heat Pump Service" description="Heat pump repair in Laurel, MD. Defrost issues, refrigerant, compressors, and dual-fuel systems. Same-day service.">
  <section class="page-hero">
    <div class="container">
      <h1>Heat Pump Repair in Laurel, MD</h1>
      <p>Heat pumps and dual-fuel systems need specialized diagnosis. We service all major brands and configurations.</p>
      <p style="margin-top:1.25rem"><a href={`tel:${phone}`} class="btn btn-primary">Get a Quote — {phoneDisplay}</a></p>
    </div>
  </section>
  <section class="content-section">
    <div class="container prose">
      <h2>Heat Pump &amp; Dual-Fuel Specialists</h2>
      <p>Many Laurel-area homes use heat pumps or dual-fuel systems for year-round comfort. Common issues include defrost failures, refrigerant leaks, reversing valve problems, and outdoor unit icing.</p>
      <h3>Services Include</h3>
      <ul>
        <li>Defrost board and sensor diagnosis</li>
        <li>Refrigerant leak detection and recovery</li>
        <li>Compressor and outdoor fan service</li>
        <li>Reversing valve and control board repairs</li>
        <li>Dual-fuel changeover thermostat setup</li>
      </ul>
      <p><a href={`tel:${phone}`} class="btn btn-primary">Schedule Heat Pump Repair</a></p>
    </div>
  </section>
</Layout>
