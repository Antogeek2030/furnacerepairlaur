---
import Layout from '../layouts/Layout.astro';
const phone = '+13015550199';
const phoneDisplay = '(301) 555-0199';
---
<Layout title="Contact | Furnace Repair Laurel MD" description="Contact furnace repair in Laurel, MD. Call or text for same-day service. 14305 Cherry Lane Ct #116, Laurel, MD 20707.">
  <section class="page-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Call or text for same-day furnace repair in Laurel and Prince George's County.</p>
    </div>
  </section>
  <section class="content-section">
    <div class="container" style="max-width:720px;margin:0 auto;text-align:center;">
      <h2 style="color:var(--primary);margin-bottom:1rem;">Get in Touch</h2>
      <p style="font-size:1.5rem;font-weight:700;margin-bottom:0.5rem;"><a href={`tel:${phone}`} style="color:var(--accent);">{phoneDisplay}</a></p>
      <p style="color:var(--text-muted);margin-bottom:2rem;">Available 24 / 7 for emergency furnace repair</p>
      <div style="background:var(--bg-section);border-radius:12px;padding:2rem;text-align:left;">
        <h3 style="color:var(--primary);margin-bottom:0.75rem;">📍 Address</h3>
        <p>14305 Cherry Lane Ct #116<br />Laurel, MD 20707<br />United States</p>
        <h3 style="color:var(--primary);margin:1.5rem 0 0.75rem;">Hours</h3>
        <p>Emergency service: 24 hours / 7 days<br />Standard service: Same-day appointments available</p>
      </div>
      <div class="map-embed" style="margin-top:2rem;">
        <iframe
          title="Map of 14305 Cherry Lane Ct, Laurel, MD"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-76.88%2C39.07%2C-76.81%2C39.13&amp;layer=mapnik&amp;marker=39.0993%2C-76.8483"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
