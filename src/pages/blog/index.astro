---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Blog | Furnace Repair Laurel MD" description="Tips on furnace repair, maintenance, and heating efficiency for homeowners in Laurel and Prince George's County, MD.">
  <section class="page-hero">
    <div class="container">
      <h1>Furnace Tips &amp; Guides</h1>
      <p>Practical advice for keeping your Laurel home warm and your system running efficiently.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <article class="blog-card">
            <div class="blog-card-body">
              <div class="blog-card-date">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <a href={`/blog/${post.slug}/`}>Read more →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
